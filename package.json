{
  "name": "eslint-plugin-powershell",
  "version": "0.1.0",
  "description": "Native-PowerShell-free ESLint plugin, parser, and CLI for linting PowerShell scripts.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "oxlint",
    "powershell",
    "psscriptanalyzer",
    "tree-sitter"
  ],
  "license": "MIT",
  "bin": {
    "powershell-eslint": "./bin/powershell-eslint.js"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./parser": "./src/parser.js",
    "./linter": "./src/linter.js"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm run lint:fixtures && pnpm pack --dry-run --json",
    "check:ci": "pnpm run lint:ci && pnpm run format:check:ci && pnpm test && pnpm run lint:fixtures && pnpm pack --dry-run --json",
    "format": "oxfmt \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "oxfmt --check \"**/*.{js,json,md,yml,yaml}\"",
    "format:check:ci": "oxfmt --check \"**/*.{js,json,md,yml,yaml}\" --threads=1",
    "lint": "oxlint . --deny-warnings",
    "lint:ci": "oxlint . --deny-warnings --threads=1",
    "lint:fixtures": "node ./bin/powershell-eslint.js test/fixtures/clean.ps1 --format stylish",
    "test": "node --test"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0"
  },
  "peerDependencies": {
    "eslint": ">=8.57 || >=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@11.3.0"
}
